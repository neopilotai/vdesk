{
  "name": "@vdesk/desktop",
  "version": "2.2.2",
  "license": "MIT",
  "description": "VDESK Desktop Sandbox - isolated cloud environment with a desktop-like interface powered by VDESK. Ready for AI Computer Use",
  "author": {
    "name": "FoundryLabs, Inc.",
    "email": "hello@vdesk.dev",
    "url": "https://vdesk.dev"
  },
  "keywords": [
    "vdesk",
    "ai-agents",
    "agents",
    "ai",
    "computer-use",
    "sandbox",
    "code",
    "runtime",
    "vm"
  ],
  "bugs": "https://github.com/vdesk-dev/desktop/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/vdesk-dev/desktop",
    "directory": "packages/js-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "defaults"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "test": "vitest run --disable-console-intercept",
    "example": "npx tsx example.mts",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/ example.mts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "dotenv": "^16.4.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "vdesk": "workspace:*"
  }
}